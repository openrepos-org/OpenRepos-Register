{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrepos.org/schema/register.schema.json",
  "title": "OpenRepos register",
  "description": "All subdomain claims, keyed by supported domain and then by subdomain.",
  "type": "object",
  "required": [
    "openrepos.io",
    "openrepos.org",
    "openrepos.sh",
    "repos.one",
    "sourcepage.io",
    "sourcepage.org",
    "sourcepage.sh"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "openrepos.io": { "$ref": "#/$defs/domain" },
    "openrepos.org": { "$ref": "#/$defs/domain" },
    "openrepos.sh": { "$ref": "#/$defs/domain" },
    "repos.one": { "$ref": "#/$defs/domain" },
    "sourcepage.io": { "$ref": "#/$defs/domain" },
    "sourcepage.org": { "$ref": "#/$defs/domain" },
    "sourcepage.sh": { "$ref": "#/$defs/domain" }
  },
  "$defs": {
    "domain": {
      "type": "object",
      "description": "Claims under this domain, keyed by subdomain.",
      "patternProperties": {
        "^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])$": { "$ref": "#/$defs/claim" }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "description": "A claim. Ownership is verified from the pull request author, so no owner field is needed.",
      "required": ["repo", "target"],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+$",
          "description": "Public GitHub repository of the open source project."
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$",
          "description": "CNAME target hostname, e.g. octocat.github.io."
        },
        "txt": {
          "type": "object",
          "description": "Optional provider verification TXT record; created as <name>.<subdomain>.<domain>.",
          "required": ["name", "value"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^_[a-z0-9_-]{1,62}$",
              "description": "Single DNS label relative to the claimed subdomain; must start with an underscore."
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[\\x20-\\x7E]+$",
              "description": "TXT value supplied by the hosting provider."
            }
          }
        }
      }
    }
  }
}
